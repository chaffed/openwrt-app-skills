#!/bin/sh
# rpcd plugin exposing __TITLE__ to LuCI as ubus object "luci.__APP__".
# Input arrives as JSON on stdin. Secrets are handed on through stdin or
# the environment, never the command line, which any process can read.
# shellcheck shell=dash disable=SC1091,SC2154

. /usr/share/libubox/jshn.sh

case "$1" in
	list)
		echo '{"status":{},"data":{"since":0,"until":0},"check":{},"set_secret":{"secret":"str"},"clear":{}}'
		;;
	call)
		case "$2" in
			status)
				/usr/bin/__APP__ status
				;;
			data)
				read -r input
				json_load "$input"
				json_get_var since since
				json_get_var until until
				/usr/bin/__APP__ data "${since:-0}" "${until:-}"
				;;
			check)
				/usr/bin/__APP__ check >/dev/null 2>&1
				/usr/bin/__APP__ status
				;;
			set_secret)
				read -r input
				json_load "$input"
				json_get_var secret secret
				printf '%s\n' "$secret" | /usr/bin/__APP__ set-secret
				;;
			clear)
				/usr/bin/__APP__ clear
				;;
		esac
		;;
esac
